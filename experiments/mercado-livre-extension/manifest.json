{
  "manifest_version": 3,
  "name": "Dropou — Mercado Livre (experimento)",
  "version": "0.1.0",
  "description": "Teste local e explícito de geração de links pelo Gerador oficial do Mercado Livre.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dropou — Testar link",
    "default_popup": "popup.html"
  }
}
