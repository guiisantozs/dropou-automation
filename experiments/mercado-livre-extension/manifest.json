{
  "manifest_version": 3,
  "name": "Dropou — Mercado Livre (experimento)",
  "version": "0.3.0",
  "description": "Conversor experimental com lote de até cinco ofertas e pausa manual.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dropou — Testar link",
    "default_popup": "popup.html"
  }
}
