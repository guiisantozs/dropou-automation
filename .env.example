# Cadastro real exige URL, chave publicável e login. Não há fallback demo.
NEXT_PUBLIC_SUPABASE_URL="https://wqpdyfipjsnyzxktacqh.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_u2ZqsQvZgDfaYomk7lvOtw_mdnAhy3B"
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa recomendada à service role legada; somente no servidor.
SUPABASE_SECRET_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Automação pausada enquanto o fluxo manual está em validação.
ENABLE_AUTOMATIONS=false
# APIs oficiais de marketplace: somente servidor. Nunca prefixar com NEXT_PUBLIC_.
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_SEARCH_APPROVED=false
# OAuth Authorization Code + PKCE; somente servidor.
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# OAuth: preencher somente depois de obter o domínio HTTPS real do deploy.
APP_BASE_URL=
MERCADO_LIVRE_REDIRECT_URI=
# Chave AES-256 em base64 (32 bytes); nunca NEXT_PUBLIC nem no Git.
MERCADO_LIVRE_TOKEN_ENCRYPTION_KEY=
# UUID(s) de administrador do Supabase Auth, separados por vírgula.
MERCADO_LIVRE_ADMIN_USER_IDS=
# Shopee Affiliate Open API brasileira: somente no servidor.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_APPROVED=false
SHOPEE_DAILY_REQUEST_LIMIT=10
# Produção bloqueada durante a validação. Exige também liberação no painel.
SHOPEE_AUTOMATION_LIVE=false
# Canal separado para envio de teste explícito, nunca um destino de produção.
TELEGRAM_TEST_CHAT_ID=
SHOPEE_TELEGRAM_TEST_ENABLED=false
# Dropou AI: somente backend. A ativação por clique exige também ai_budget.enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ENABLED=false
# Ativar apenas após autorizar o primeiro teste visual pago.
OPENAI_VISION_ENABLED=false
AI_ADMIN_USER_IDS=
# Só para outros modelos: verificar preços oficiais antes da troca.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_USD_PER_MILLION=
OPENAI_CACHE_WRITE_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Lookup permanece bloqueado após os 403 até aprovação explícita da plataforma.
MERCADO_LIVRE_LOOKUP_APPROVED=false

# Cotas internas independentes; respostas reais de limite da Shopee continuam respeitadas.
SHOPEE_MANUAL_DAILY_REQUEST_LIMIT=200
SHOPEE_DISCOVERY_DAILY_REQUEST_LIMIT=40
# O bot principal pode ser reutilizado. Configure estes somente se escolher bots separados.
TELEGRAM_CELULARES_BOT_TOKEN=
TELEGRAM_TENIS_BOT_TOKEN=
TELEGRAM_AUTOMOTO_BOT_TOKEN=
